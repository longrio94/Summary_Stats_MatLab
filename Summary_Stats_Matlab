import pandas as pd
import numpy as np
from statsmodels.tsa.stattools import adfuller
from statsmodels.tsa.statespace.sarimax import SARIMAX
from pmdarima import auto_arima
from sklearn.metrics import mean_squared_error

# ---- Utility Functions ----
def check_stationarity(series, significance_level=0.05):
    """Check if a series is stationary using the Augmented Dickey-Fuller test."""
    result = adfuller(series.dropna())
    return result[1] < significance_level  # True if stationary

def make_stationary(series, max_diffs=3):
    """Difference a series until it becomes stationary or reaches the max limit."""
    diff_count = 0
    while not check_stationarity(series) and diff_count < max_diffs:
        series = series.diff().dropna()
        diff_count += 1
    return series, diff_count

# ---- Load Data ----
# Example data
df = pd.DataFrame({
    'ODR': [0.02, 0.025, 0.023, 0.03, 0.027, 0.03, 0.032, 0.035],
    'CPI': [1.5, 1.6, 1.7, 1.8, 1.9, 2.0, 2.1, 2.2],
    'HPI': [100, 102, 104, 106, 108, 110, 112, 114],
    'GDP': [2.5, 2.6, 2.4, 2.3, 2.7, 2.8, 2.9, 3.0],
    'Unemployment_rate': [5.1, 5.0, 5.2, 5.3, 5.1, 4.9, 4.8, 4.7]
})

# ---- Step 1: Stationarize Target Variable ----
odr_stationary, odr_diff_count = make_stationary(df['ODR'])
if odr_diff_count > 0:
    print(f"'ODR' differenced {odr_diff_count} time(s) to achieve stationarity.")
else:
    print("'ODR' is already stationary.")

# Add the stationary ODR back to the dataframe
df['ODR_stationary'] = odr_stationary

# ---- Step 2: Create Lagged Features ----
lags = 1
df['CPI_lag1'] = df['CPI'].shift(1)
df['HPI_lag1'] = df['HPI'].shift(1)

# ---- Step 3: Drop NaN Rows to Synchronize Data ----
# Drop rows where any column has NaN
df.dropna(inplace=True)

# ---- Step 4: Extract Endogenous and Exogenous Variables ----
endog = df['ODR_stationary']
exog = df[['CPI_lag1', 'HPI_lag1']]

print(f"Length of endog: {len(endog)}, Length of exog: {len(exog)}")

# ---- Step 5: Fit Auto ARIMA ----
auto_model = auto_arima(
    endog,
    X=exog,
    seasonal=False,
    stepwise=True,
    trace=True,
    max_p=1,  # Simplified AR lags
    max_q=1,  # Simplified MA lags
    max_d=1,  # Simplified differencing
    suppress_warnings=True
)

best_order = auto_model.order
print(f"Best ARIMA Order: {best_order}")

# ---- Step 6: Fit SARIMAX Model ----
model = SARIMAX(endog, exog=exog, order=best_order)
sarimax_model = model.fit(disp=False)

print(sarimax_model.summary())

# ---- Step 7: Forecast ----
forecast = sarimax_model.forecast(steps=3, exog=exog.iloc[-3:])
print("Forecasted ODR:", forecast.values)

# ---- Step 8: Evaluate Model ----
actual = endog[-3:]
rmse = np.sqrt(mean_squared_error(actual, forecast))
print(f"RMSE: {rmse:.4f}")
