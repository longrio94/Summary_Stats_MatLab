import pandas as pd
import numpy as np
import re

def remove_highly_correlated_features(df, threshold=0.75):
    # Exclude 'logit_ODR' from correlation analysis
    df_selected = df[[col for col in df.columns if col != 'logit_ODR']]
    
    # Compute absolute correlation matrix
    corr_matrix = df_selected.corr().abs()
    
    # Get upper triangle of the correlation matrix
    upper = corr_matrix.where(np.triu(np.ones(corr_matrix.shape), k=1).astype(bool))
    
    # Identify columns to drop based on correlation threshold
    to_drop = set()
    
    for column in upper.columns:
        if any(upper[column] > threshold):
            # Extract suffix (e.g., L1, L2, L3, L4)
            match = re.search(r'L(\d+)$', column)
            if match:
                suffix = int(match.group(1))  # Convert suffix to integer
                
                # Get all columns with the same base name but different L-values
                base_name = column[:-len(match.group(0))]
                similar_cols = [col for col in df_selected.columns if col.startswith(base_name) and re.search(r'L(\d+)$', col)]
                
                # Find the lowest suffix among them
                lowest_col = min(similar_cols, key=lambda x: int(re.search(r'L(\d+)$', x).group(1)))
                
                # Drop only if it is not the lowest
                if column != lowest_col:
                    to_drop.add(column)
    
    # Drop selected columns
    df.drop(columns=to_drop, inplace=True)
    
    return df, to_drop
