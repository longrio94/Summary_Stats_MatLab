import pandas as pd
import numpy as np
from sklearn.linear_model import Lasso, LinearRegression
from sklearn.feature_selection import RFE
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score, mean_absolute_percentage_error
from sklearn.model_selection import cross_val_score, GridSearchCV
from itertools import combinations
from statsmodels.stats.stattools import jarque_bera
from statsmodels.tsa.stattools import adfuller
from statsmodels.stats.diagnostic import het_white
from scipy import stats

class IFRS9PDRegression:
    def __init__(self, feature_config, method="Combination", corr_threshold=0.7, 
                 min_combinations=2, lasso_alphas=None):
        self.feature_config = feature_config
        self.method = method
        self.corr_threshold = corr_threshold
        self.min_combinations = min_combinations
        self.lasso_alphas = lasso_alphas or [0.001, 0.01, 0.1, 1, 10]
        self.model = None
        self.scaler = StandardScaler()
        self.selected_features = None
        
    @staticmethod
    def logit_transform(x):
        return np.log(x / (1 - x))
    
    def feature_engineering(self, df):
        print("Starting feature engineering...")
        df_engineered = df.copy()
        
        # Apply logit transformation and create lagged features for ODR
        df_engineered['Logit_ODR'] = self.logit_transform(df_engineered['ODR'])
        if 'ODR' in self.feature_config:
            for transform, degree in self.feature_config['ODR'].items():
                if transform == "lag":
                    for i in range(1, degree + 1):
                        df_engineered[f'Logit_ODR_lag{i}'] = df_engineered['Logit_ODR'].shift(i)
                elif transform == "mom_change":
                    df_engineered['Logit_ODR_mom'] = df_engineered['Logit_ODR'].pct_change()
                elif transform == "yoy_change":
                    df_engineered['Logit_ODR_yoy'] = df_engineered['Logit_ODR'].pct_change(periods=12)
        
        # Feature engineering for other variables
        for feature, transformations in self.feature_config.items():
            if feature == 'ODR':
                continue  # We've already handled ODR
            if feature not in df_engineered.columns:
                continue
            for transform, degree in transformations.items():
                if transform == "lag":
                    for i in range(1, degree + 1):
                        df_engineered[f"{feature}_lag{i}"] = df_engineered[feature].shift(i)
                elif transform == "moving_avg":
                    df_engineered[f"{feature}_movavg{degree}"] = df_engineered[feature].rolling(window=degree).mean()
                elif transform == "poly":
                    for i in range(2, degree + 1):
                        df_engineered[f"{feature}_poly{i}"] = df_engineered[feature] ** i
                elif transform == "mom_change":
                    df_engineered[f"{feature}_mom"] = df_engineered[feature].pct_change()
                elif transform == "yoy_change":
                    df_engineered[f"{feature}_yoy"] = df_engineered[feature].pct_change(periods=12)
                elif transform == "delta_diff":
                    df_engineered[f"{feature}_delta"] = df_engineered[feature].diff()
        
        df_engineered = df_engineered.dropna()
        print(f"Feature engineering complete. Shape: {df_engineered.shape}")
        return df_engineered
    
    def feature_screening(self, df):
        print("Starting feature screening...")
        corr_matrix = df.corr().abs()
        upper_triangle = corr_matrix.where(np.triu(np.ones(corr_matrix.shape), k=1).astype(bool))
        to_drop = [column for column in upper_triangle.columns if any(upper_triangle[column] > self.corr_threshold)]
        df_screened = df.drop(columns=to_drop)
        print(f"Feature screening complete. Remaining features: {df_screened.columns.tolist()}")
        return df_screened
    
    def scale_features(self, X):
        print("Scaling features...")
        return pd.DataFrame(self.scaler.fit_transform(X), columns=X.columns, index=X.index)
    
    def combination_selection(self, X, y):
        print("Starting combination selection...")
        results = []
        features = X.columns
        for k in range(self.min_combinations, len(features) + 1):
            for combo in combinations(features, k):
                model = LinearRegression()
                model.fit(X[list(combo)], y)
                y_pred = model.predict(X[list(combo)])
                mape = mean_absolute_percentage_error(y, y_pred)
                results.append((combo, mape, model))
        
        results = sorted(results, key=lambda x: x[1])
        best_features = list(results[0][0])
        print(f"Combination selection complete. Best features: {best_features}")
        return X[best_features], results[:5]  # Return only top 5 combinations
    
    def embedded_selection(self, X, y):
        print("Starting embedded selection (Lasso)...")
        print(f"Shape of X before Lasso: {X.shape}")
        print(f"Shape of y before Lasso: {y.shape}")
        if X.empty or y.empty:
            raise ValueError("X or y is empty after preprocessing")
        
        lasso_cv = GridSearchCV(Lasso(), {'alpha': self.lasso_alphas}, cv=5, scoring='neg_mean_squared_error')
        lasso_cv.fit(X, y)
        best_alpha = lasso_cv.best_params_['alpha']
        print(f"Best Lasso alpha: {best_alpha}")
        
        lasso = Lasso(alpha=best_alpha)
        lasso.fit(X, y)
        selected_features = X.columns[lasso.coef_ != 0]
        print(f"Number of features selected by Lasso: {len(selected_features)}")
        if len(selected_features) == 0:
            print("Warning: Lasso selected no features. Using all features.")
            return X
        return X[selected_features]
    
    def wrapper_selection(self, X, y):
        print("Starting wrapper selection (RFE)...")
        print(f"Shape of X before RFE: {X.shape}")
        print(f"Shape of y before RFE: {y.shape}")
        if X.empty or y.empty:
            raise ValueError("X or y is empty after Lasso selection")
        
        model = LinearRegression()
        rfe = RFE(model, n_features_to_select=None)  # Use all features
        rfe.fit(X, y)
        selected_features = X.columns[rfe.support_]
        print(f"Number of features selected by RFE: {len(selected_features)}")
        return X[selected_features]
    
    def train_model(self, X, y):
        print("Training final model...")
        self.model = LinearRegression()
        self.model.fit(X, y)
        return self.model
    
    def evaluate_model(self, X, y):
        print("Evaluating model...")
        y_pred = self.model.predict(X)
        mse = mean_squared_error(y, y_pred)
        mae = mean_absolute_error(y, y_pred)
        r2 = r2_score(y, y_pred)
        adjusted_r2 = 1 - (1-r2)*(len(y)-1)/(len(y)-X.shape[1]-1)
        cv_scores = cross_val_score(self.model, X, y, cv=5)
        return {
            'MSE': mse,
            'MAE': mae,
            'R2': r2,
            'Adjusted R2': adjusted_r2,
            'Cross-validation scores': cv_scores,
            'Mean CV score': np.mean(cv_scores)
        }
    
    def diagnostic_tests(self, X, y, model):
        print("Performing diagnostic tests...")
        y_pred = model.predict(X)
        residuals = y - y_pred
        
        # Normality of Residuals: Jarque-Bera test
        jb_stat, jb_pvalue, *_ = jarque_bera(residuals)
        
        # Stationarity: ADF test
        adf_stat, adf_pvalue, *_ = adfuller(residuals)
        
        # Heteroskedasticity: White's test
        white_stat, white_pvalue, *_ = het_white(residuals, X)
        
        # Monotonicity: Mann-Kendall test
        mk_stat, mk_pvalue, *_ = stats.mstats.kendalltau(range(len(residuals)), residuals)
        
        return {
            'Jarque-Bera stat': jb_stat,
            'Jarque-Bera p-value': jb_pvalue,
            'ADF stat': adf_stat,
            'ADF p-value': adf_pvalue,
            'White stat': white_stat,
            'White p-value': white_pvalue,
            'Mann-Kendall stat': mk_stat,
            'Mann-Kendall p-value': mk_pvalue
        }
    
    def fit(self, df):
        print(f"Starting model fitting. Input shape: {df.shape}")
        df_engineered = self.feature_engineering(df)
        X = df_engineered.drop(columns=['ODR', 'Logit_ODR'])
        y = df_engineered['Logit_ODR']
        print(f"Shape of X after feature engineering: {X.shape}")
        print(f"Shape of y: {y.shape}")
        
        X = self.feature_screening(X)
        print(f"Shape of X after feature screening: {X.shape}")
        X_scaled = self.scale_features(X)
        
        if self.method == "Combination":
            X_selected, top_combinations = self.combination_selection(X_scaled, y)
            print("Top 5 Combinations:")
            for i, (combo, mape, model) in enumerate(top_combinations, 1):
                print(f"\nModel {i}:")
                print(f"Features: {combo}")
                print(f"MAPE: {mape}")
                
                diagnostics = self.diagnostic_tests(X_scaled[list(combo)], y, model)
                print("Diagnostic Tests:")
                for key, value in diagnostics.items():
                    print(f"  {key}: {value}")
            
            self.selected_features = X_selected.columns
            
        elif self.method == "Embedded_Wrapper":
            X_embedded = self.embedded_selection(X_scaled, y)
            print(f"Features selected after Lasso: {X_embedded.columns.tolist()}")
            X_selected = self.wrapper_selection(X_embedded, y)
            self.selected_features = X_selected.columns
            print(f"Final selected features: {self.selected_features.tolist()}")
            
            model = self.train_model(X_selected, y)
            diagnostics = self.diagnostic_tests(X_selected, y, model)
            print("\nDiagnostic Tests for Final Model:")
            for key, value in diagnostics.items():
                print(f"  {key}: {value}")
        
        else:
            raise ValueError("Invalid method. Choose 'Combination' or 'Embedded_Wrapper'")
        
        self.train_model(X_selected, y)
        evaluation_metrics = self.evaluate_model(X_selected, y)
        print("\nModel Evaluation Metrics:")
        for metric, value in evaluation_metrics.items():
            print(f"{metric}: {value}")
        
        return self
    
    def predict(self, oot_data):
        print("Making predictions on out-of-time data...")
        oot_engineered = self.feature_engineering(oot_data)
        oot_features = oot_engineered[self.selected_features]
        oot_features_scaled = pd.DataFrame(self.scaler.transform(oot_features), 
                                           columns=oot_features.columns, 
                                           index=oot_features.index)
        return self.model.predict(oot_features_scaled)

