import pandas as pd
import numpy as np
from sklearn.linear_model import Lasso, LinearRegression
from sklearn.feature_selection import RFE
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import mean_absolute_error, mean_squared_error

# --- Logit Transformation ---
def logit_transform(x):
    return np.log(x / (1 - x))

# --- Feature Engineering ---
def feature_engineering(df, feature_config):
    for feature, transformations in feature_config.items():
        if feature not in df.columns:
            continue
        for transform, degree in transformations.items():
            if transform == "lag":
                for i in range(1, degree + 1):
                    df[f"{feature}_lag{i}"] = df[feature].shift(i)
            elif transform == "moving_avg":
                df[f"{feature}_movavg{degree}"] = df[feature].rolling(window=degree).mean()
            elif transform == "poly":
                for i in range(2, degree + 1):
                    df[f"{feature}_poly{i}"] = df[feature] ** i
    return df.dropna()

# --- Feature Screening ---
def feature_screening(df, corr_threshold=0.7):
    corr_matrix = df.corr().abs()
    upper_triangle = corr_matrix.where(np.triu(np.ones(corr_matrix.shape), k=1).astype(bool))
    to_drop = [column for column in upper_triangle.columns if any(upper_triangle[column] > corr_threshold)]
    return df.drop(columns=to_drop)

# --- Scaling Features ---
def scale_features(X, scaler=None):
    if scaler is None:
        scaler = StandardScaler()
        X_scaled = pd.DataFrame(scaler.fit_transform(X), columns=X.columns, index=X.index)
    else:
        X_scaled = pd.DataFrame(scaler.transform(X), columns=X.columns, index=X.index)
    return X_scaled, scaler

# --- Combination Selection ---
def combination_selection(X, y, max_combinations=5):
    from itertools import combinations
    from sklearn.metrics import mean_absolute_percentage_error

    results = []
    features = X.columns
    for k in range(2, len(features) + 1):
        for combo in combinations(features, k):
            model = LinearRegression()
            model.fit(X[list(combo)], y)
            y_pred = model.predict(X[list(combo)])
            mape = mean_absolute_percentage_error(y, y_pred)
            results.append((combo, mape))
    
    # Sort by MAPE and return top combinations
    results = sorted(results, key=lambda x: x[1])
    top_combinations = results[:max_combinations]
    best_features = list(top_combinations[0][0])  # Best combination
    return X[best_features], top_combinations

# --- Wrapper Selection ---
def wrapper_selection(X, y, n_features_to_select):
    model = LinearRegression()
    rfe = RFE(model, n_features_to_select=n_features_to_select)
    X_selected = rfe.fit_transform(X, y)
    selected_features = X.columns[rfe.support_]
    return X[selected_features]

# --- Embedded Selection ---
def embedded_selection(X, y, alpha=0.01):
    lasso = Lasso(alpha=alpha)
    lasso.fit(X, y)
    selected_features = X.columns[lasso.coef_ != 0]
    return X[selected_features]

# --- Model Training ---
def train_model(X, y):
    model = LinearRegression()
    model.fit(X, y)
    return model

# --- Full Pipeline ---
def run_pipeline(df, oot_data, feature_config, 
                 corr_threshold=0.7, 
                 variable_selection_method="Combination", 
                 max_combinations=5, 
                 n_features_to_select=5, 
                 alpha=0.01):
    # Step 1: Logit Transformation
    df['Logit_ODR'] = logit_transform(df['ODR'])
    
    # Step 2: Feature Engineering
    X = df.drop(columns=['ODR', 'Logit_ODR'])
    y = df['Logit_ODR']
    X = feature_engineering(X, feature_config)
    
    # Step 3: Feature Screening
    X = feature_screening(X, corr_threshold)
    
    # Step 4: Scaling Features
    X_scaled, scaler = scale_features(X)
    
    # Step 5: Variable Selection
    if variable_selection_method == "Combination":
        X_selected, top_combinations = combination_selection(X_scaled, y, max_combinations)
        print("Top Combinations:", top_combinations)
    elif variable_selection_method == "Wrapper":
        X_selected = wrapper_selection(X_scaled, y, n_features_to_select)
    elif variable_selection_method == "Embedded":
        X_selected = embedded_selection(X_scaled, y, alpha)
    else:
        raise ValueError("Invalid variable selection method")
    
    # Step 6: Train Model
    model = train_model(X_selected, y)
    
    # Step 7: Predict OOT Data
    combined_data = pd.concat([df, oot_data])
    combined_data = feature_engineering(combined_data, feature_config)
    oot_features = combined_data.loc[oot_data.index, X_selected.columns]
    oot_features_scaled, _ = scale_features(oot_features, scaler)
    predictions = model.predict(oot_features_scaled)
    
    return model, predictions, X_selected.columns

# --- Example Usage ---
df = pd.DataFrame({
    'ODR': [0.01, 0.02, 0.03, 0.025, 0.015],
    'GDP': [2.5, 2.7, 2.9, 2.6, 2.4],
    'CPI': [100, 102, 101, 103, 99],
    'UNR': [5, 4.9, 5.1, 4.8, 5.2]
})
oot_data = pd.DataFrame({
    'ODR': [0.02, 0.018],
    'GDP': [2.8, 2.6],
    'CPI': [104, 98],
    'UNR': [4.7, 5.3]
})
feature_config = {
    'GDP': {'lag': 2, 'moving_avg': 2},
    'CPI': {'poly': 2},
    'UNR': {'lag': 1}
}
model, predictions, selected_features = run_pipeline(
    df, oot_data, feature_config, 
    variable_selection_method="Combination",
    max_combinations=5
)
print("OOT Predictions:", predictions)
print("Selected Features:", selected_features)
